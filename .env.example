# ---------------------------------------------------------------
# 最快的方式（二选一）
#   A. 在 pi 终端里：/lark-setup（本包已作为 pi 插件安装时）
#      —— 打开链接创建应用，配置写到 ~/.pi/lark/.env，随后 /lark-start 后台连接
#   B. 在命令行里：npm run setup
#      —— 打开链接即可创建应用并自动写入本文件（可加 --lark 使用国际版；用
#         --app-id cli_xxx 则预填已有应用的缺失权限/事件）
# 手填方式：飞书 / Lark 自建应用凭据（开发者后台 > 凭证与基础信息）
# ---------------------------------------------------------------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# feishu = 飞书（中国），lark = Lark（国际）
FEISHU_DOMAIN=feishu

# websocket = 长连接（推荐，无需公网地址），webhook = HTTP 回调
FEISHU_CONNECTION_MODE=websocket

# 仅 webhook 模式使用：在「事件与回调 > 加密策略」中获取
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
# FEISHU_WEBHOOK_HOST=127.0.0.1
# FEISHU_WEBHOOK_PORT=8765
# FEISHU_WEBHOOK_PATH=/feishu/webhook

# ---------------------------------------------------------------
# 访问控制
# ---------------------------------------------------------------
# 允许使用的用户 open_id（逗号分隔，ou_xxx）。留空表示私聊不限、
# 群聊按下面的群策略处理。
FEISHU_ALLOWED_USERS=
# open：群里 @机器人 即可用；allowlist：仅白名单用户（留空=群里全部拒绝）；
# disabled：忽略所有群消息
FEISHU_GROUP_POLICY=allowlist
# 群聊中是否必须 @机器人 才响应
FEISHU_REQUIRE_MENTION=true
# 是否响应其他机器人的消息：none | mentions | all
FEISHU_ALLOW_BOTS=none
# 群聊内按用户隔离会话上下文（true = 每个人有独立的 pi 会话）
FEISHU_GROUP_SESSIONS_PER_USER=true
# 用于接收上线通知/告警的会话 chat_id（oc_xxx），可留空
FEISHU_HOME_CHANNEL=

# ---------------------------------------------------------------
# pi 编码代理
# ---------------------------------------------------------------
# pi 可执行文件；默认取 PATH 中的 pi
PI_BIN=pi
# pi 的工作目录（agent 读写代码的根目录），默认启动本程序时所在目录
# PI_CWD=C:\path\to\repo
# pi 会话文件目录，默认 .pi-lark/pi-sessions
# PI_SESSION_DIR=
# 指定模型（如 anthropic/claude-sonnet-4-5 或 openai/gpt-5），留空用 pi 默认
# PI_MODEL=
# 思考级别：off | minimal | low | medium | high | xhigh | max
# PI_THINKING=
# 追加给 pi 的其它参数（空格分隔），例如：--tools read,bash,edit,write
# PI_EXTRA_ARGS=
# 是否信任仓库内的 pi 扩展/资源（等价于 pi --approve）
# ⚠ 注意：开启后，被桥接的仓库自带的 pi 扩展/资源会被自动执行——
#   只对你自己的仓库开启；桥接不信任的仓库时请设为 false。
PI_APPROVE=true
# 空闲多久后关闭 pi 进程（会话文件保留，下次消息自动恢复）
PI_IDLE_TIMEOUT_MS=1800000
# 同时常驻的 pi 进程上限
PI_MAX_AGENTS=4
# pi 启动就绪超时（毫秒）
PI_READY_TIMEOUT_MS=60000
# 单条 RPC 命令（除长任务外）的响应超时（毫秒）
PI_REQUEST_TIMEOUT_MS=120000
# 单次运行的最长时间（毫秒），超时会自动中止
PI_RUN_TIMEOUT_MS=1800000

# ---------------------------------------------------------------
# 桥接行为
# ---------------------------------------------------------------
# 卡片流式刷新间隔（毫秒）
BRIDGE_CARD_UPDATE_INTERVAL_MS=900
# 卡片内流式预览的最大字符数（超出只显示最近内容）
BRIDGE_STREAM_PREVIEW_CHARS=4000
# 卡片内最终回答的最大字符数（超出部分拆成后续消息发送）
BRIDGE_FINAL_CARD_CHARS=6000
# 是否在卡片中展示思考摘要 / 工具调用 / 用量
BRIDGE_SHOW_THINKING=true
BRIDGE_SHOW_TOOLS=true
BRIDGE_SHOW_USAGE=true
# 连发消息合并
BRIDGE_TEXT_BATCH_DELAY_MS=600
# 附件限制
BRIDGE_MAX_IMAGES=4
BRIDGE_MAX_IMAGE_BYTES=8388608
BRIDGE_MAX_FILE_BYTES=52428800
# 运行期间本地排队等待的消息上限（超出会提示用户稍后再发）
BRIDGE_MAX_QUEUED_MESSAGES=10
# 附件收件箱文件保留时长（毫秒），超龄自动清理；0 = 不清理
BRIDGE_INBOX_MAX_AGE_MS=604800000
# 运行数据目录（会话映射、附件收件箱）
BRIDGE_DATA_DIR=.pi-lark

# debug | info | warn | error
LOG_LEVEL=info
