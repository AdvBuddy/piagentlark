{
  "name": "pi-lark-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Feishu / Lark bot gateway bridging chat messages to the pi coding agent over its RPC mode",
  "keywords": [
    "pi-package",
    "pi-extension",
    "feishu",
    "lark",
    "coding-agent"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "setup": "tsx src/setup.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
